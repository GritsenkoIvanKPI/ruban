# Defense in depth: never serve the secrets file or stray backups as plain text,
# even if PHP execution were ever misconfigured on the server.
# Written for both Apache 2.4+ (mod_authz_core) and 2.2-style hosts.
<FilesMatch "^config\.php$|\.bak$|\.tmp.*$|field-meta\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
