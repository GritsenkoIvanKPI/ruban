# ---- Ruban Marine — Hostinger (Apache / LiteSpeed) ----
Options -Indexes
DirectoryIndex index.html index.php

# HTTPS + no "www"
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://rubanmarine.de%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.rubanmarine\.de$ [NC]
  RewriteRule ^ https://rubanmarine.de%{REQUEST_URI} [L,R=301]
  # Hide dotfiles and internal docs
  RewriteRule (^|/)\.(?!well-known/) - [F]
  RewriteRule \.(md|example\.php)$ - [F,NC]
</IfModule>

# Correct types for modern media
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Compression for text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Browser caching: media 30 days, fonts 1 year, pages always fresh
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
